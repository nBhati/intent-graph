{
  "version": "core/0.1",
  "description": "Core relationship kinds. Endpoint kind lists may contain '*' for any kind or '@intent'/'@observation'/'@reconciliation' for any kind of that layer. Only relations with acyclic=true are checked for cycles; calls, transitions and dependencies may legally cycle. 'impact' says which endpoint a change on the other endpoint may affect: incoming = the source is affected when the target changes; outgoing = the target is affected when the source changes; both; none.",
  "relations": [
    {"name": "contains", "impact": "incoming", "layers": ["intent", "observation"], "acyclic": true,
     "direction": "container -> contained element",
     "source_kinds": ["System", "Component", "ExternalSystem", "Screen", "Process", "Interface", "Store", "Entity", "CodeArtifact"],
     "target_kinds": ["System", "Component", "Interface", "Port", "Screen", "Control", "Store", "Process", "Action", "State", "Entity", "ValueType", "CodeArtifact", "CodeSymbol"],
     "description": "Structural membership. Acyclicity is enforced on this relation only."},
    {"name": "refines", "impact": "incoming", "layers": ["intent"],
     "direction": "more detailed definition -> broader definition",
     "source_kinds": ["@intent"], "target_kinds": ["@intent"],
     "description": "An interpretation adding detail. Does not automatically prove coverage of the parent."},
    {"name": "realizes", "impact": "incoming", "layers": ["intent"],
     "direction": "design element -> requirement or goal",
     "source_kinds": ["Component", "Interface", "Operation", "Action", "Process", "Screen", "Control", "Interaction", "Transition", "Decision", "Scenario"],
     "target_kinds": ["Goal", "Requirement", "Scenario"],
     "description": "A proposed design contribution to intent."},
    {"name": "exposes", "impact": "incoming", "layers": ["intent"],
     "direction": "component -> interface",
     "source_kinds": ["Component", "System", "ExternalSystem"], "target_kinds": ["Interface", "Port"],
     "description": "An interface made available by a component."},
    {"name": "declares", "impact": "both", "layers": ["intent"],
     "direction": "interface -> operation",
     "source_kinds": ["Interface"], "target_kinds": ["Operation", "Event"],
     "description": "The operation belongs to the interface."},
    {"name": "invokes", "impact": "incoming", "layers": ["intent"],
     "direction": "action or operation -> operation",
     "source_kinds": ["Action", "Operation", "Process", "Transition"], "target_kinds": ["Operation"],
     "property_schema": {"mode": {"type": "string", "enum": ["sync", "async"]}, "on_error": {"type": "string"}},
     "description": "Invocation. May legally form cycles (retry loops, mutual calls)."},
    {"name": "consumes", "impact": "incoming", "layers": ["intent"],
     "direction": "behavior -> message or value",
     "source_kinds": ["Action", "Operation", "Process", "Transition", "Component", "Event"], "target_kinds": ["Message", "ValueType", "Event", "Entity"],
     "description": "Information flow into behavior."},
    {"name": "produces", "impact": "incoming", "layers": ["intent"],
     "direction": "behavior -> message or value",
     "source_kinds": ["Action", "Operation", "Process", "Transition", "Component"], "target_kinds": ["Message", "ValueType", "Event", "Entity"],
     "description": "Information flow out of behavior."},
    {"name": "reads", "impact": "incoming", "layers": ["intent"],
     "direction": "behavior -> entity or store",
     "source_kinds": ["Action", "Operation", "Process", "Transition", "Component"], "target_kinds": ["Entity", "Store", "State"],
     "description": "Read access."},
    {"name": "modifies", "impact": "incoming", "layers": ["intent"],
     "direction": "behavior -> entity or store",
     "source_kinds": ["Action", "Operation", "Process", "Transition", "Component"], "target_kinds": ["Entity", "Store", "State"],
     "description": "Write effect."},
    {"name": "constrains", "impact": "outgoing", "layers": ["intent"],
     "direction": "constraint -> target",
     "source_kinds": ["Constraint", "PresentationRule"], "target_kinds": ["*"],
     "description": "The rule applies to the target element or interaction."},
    {"name": "depends_on", "impact": "incoming", "layers": ["intent"],
     "direction": "dependent -> dependency",
     "source_kinds": ["Component", "System", "Operation", "Action", "Process", "Interface"],
     "target_kinds": ["Component", "Interface", "Operation", "ExternalSystem", "Store", "System"],
     "required_properties": ["dependency_kind"],
     "property_schema": {"dependency_kind": {"type": "string", "enum": ["build", "runtime", "data", "availability"]}},
     "impact_rule": "dependency changes may affect incoming dependents",
     "description": "A recorded dependency; does not establish every causal effect. Impact traverses incoming edges."},
    {"name": "connects_to", "impact": "both", "layers": ["intent"],
     "direction": "port -> port",
     "source_kinds": ["Port"], "target_kinds": ["Port"],
     "required_properties": ["protocol", "direction"],
     "property_schema": {"protocol": {"type": "string"}, "direction": {"type": "string", "enum": ["unidirectional", "bidirectional"]}},
     "description": "Architectural connectivity."},
    {"name": "concerns", "impact": "incoming", "layers": ["intent", "reconciliation"],
     "direction": "question, assumption, decision, obligation or finding -> element it is about",
     "source_kinds": ["Question", "Assumption", "Decision", "Obligation", "Finding", "Assessment"], "target_kinds": ["*"],
     "description": "Relates an unresolved or supporting element to the element it is about."},
    {"name": "observes", "impact": "incoming", "layers": ["observation"],
     "direction": "observation -> code artifact or symbol",
     "source_kinds": ["Observation"], "target_kinds": ["CodeArtifact", "CodeSymbol"],
     "description": "A revision-specific fact about implementation."},
    {"name": "supports", "impact": "incoming", "layers": ["reconciliation"],
     "direction": "evidence -> requirement, mapping or obligation",
     "source_kinds": ["Evidence", "AnalysisRun", "Assessment", "TestCase"],
     "target_kinds": ["Requirement", "Mapping", "Obligation", "Constraint", "Scenario", "Assumption"],
     "description": "Scoped supporting evidence, not universal proof."},
    {"name": "challenges", "impact": "incoming", "layers": ["reconciliation"],
     "direction": "finding -> claim or modeled element",
     "source_kinds": ["Finding", "Evidence", "AnalysisRun", "Observation"], "target_kinds": ["*"],
     "description": "A conflict, failure, or reason to investigate."},
    {"name": "depicts", "impact": "incoming", "layers": ["reconciliation"],
     "direction": "review artifact -> model element",
     "source_kinds": ["ReviewArtifact"], "target_kinds": ["*"],
     "description": "Visual or textual representation of model content."}
  ]
}
