{
  "version": "core/0.3",
  "description": "Core node kinds. Property specs use a small JSON-Schema-like subset: type (string|integer|number|boolean|array|object|ref|ref_list), enum, required, items, description. 'ref' and 'ref_list' values must name existing records; reference integrity is checked by graph validation.",
  "kinds": [
    {"name": "Goal", "family": "Purpose", "layers": ["intent"],
     "description": "A desired outcome stated by a person. May remain a paragraph; refined by requirements and scenarios.",
     "properties": {}},
    {"name": "Requirement", "family": "Purpose", "layers": ["intent"],
     "description": "Expected behavior or quality that is independently tracked and can eventually gain evidence.",
     "properties": {
       "priority": {"type": "string", "enum": ["must", "should", "could"], "required": true},
       "formalization": {"type": "string", "enum": ["descriptive", "structured", "formal"], "required": true},
       "acceptance_notes": {"type": "string"}}},
    {"name": "Scenario", "family": "Purpose", "layers": ["intent"],
     "description": "A concrete example or sequence that illustrates intent, including error and boundary paths.",
     "properties": {
       "preconditions": {"type": "array", "items": {"type": "string"}},
       "steps": {"type": "array", "items": {"type": "string"}},
       "expected_outcome": {"type": "string"}}},
    {"name": "Question", "family": "Purpose", "layers": ["intent"],
     "description": "Unresolved intent that materially affects the result. Blocking questions gate readiness.",
     "properties": {
       "status": {"type": "string", "enum": ["open", "answered", "deferred"], "required": true},
       "blocking": {"type": "boolean", "required": true},
       "answer": {"type": "string"}}},

    {"name": "Actor", "family": "Structure", "layers": ["intent"],
     "description": "A participant interacting with the system (person, role, or external agent).",
     "properties": {"actor_kind": {"type": "string", "enum": ["human", "system", "service", "device"]}}},
    {"name": "System", "family": "Structure", "layers": ["intent"],
     "description": "The system or subsystem boundary being described.",
     "properties": {}},
    {"name": "Component", "family": "Structure", "layers": ["intent"],
     "description": "A unit of responsibility. Frontend, backend, service, module and package are roles, not separate roots.",
     "properties": {
       "role": {"type": "string", "enum": ["frontend", "backend", "service", "module", "package", "library", "infrastructure", "other"]},
       "technology": {"type": "string"},
       "responsibility": {"type": "string"}}},
    {"name": "ExternalSystem", "family": "Structure", "layers": ["intent"],
     "description": "A system outside the modeled boundary that is depended on or integrated with.",
     "properties": {"owner": {"type": "string"}, "protocol": {"type": "string"}}},

    {"name": "Entity", "family": "Information", "layers": ["intent"],
     "description": "A domain concept with identity and meaning (not a persistence shape).",
     "properties": {"fields": {"type": "object"}}},
    {"name": "ValueType", "family": "Information", "layers": ["intent"],
     "description": "A data shape without identity.",
     "properties": {"base_type": {"type": "string"}, "fields": {"type": "object"}}},
    {"name": "Message", "family": "Information", "layers": ["intent"],
     "description": "Information exchanged between parts of the system.",
     "properties": {"fields": {"type": "object"}}},
    {"name": "Store", "family": "Information", "layers": ["intent"],
     "description": "A persistence location for entities or messages.",
     "properties": {"store_kind": {"type": "string", "enum": ["relational", "document", "file", "memory", "cache", "queue", "other"]}}},

    {"name": "Interface", "family": "Interfaces", "layers": ["intent"],
     "description": "A contract made available by a component; declares operations and events.",
     "properties": {"protocol": {"type": "string"}, "stability": {"type": "string", "enum": ["experimental", "stable", "deprecated"]}}},
    {"name": "Operation", "family": "Interfaces", "layers": ["intent"],
     "description": "An exposed contract with inputs, outputs and failure behavior. An Action may implement it.",
     "properties": {
       "inputs": {"type": "object"}, "outputs": {"type": "object"},
       "failures": {"type": "array", "items": {"type": "string"}},
       "idempotent": {"type": "boolean"},
       "mode": {"type": "string", "enum": ["sync", "async"]}}},
    {"name": "Port", "family": "Interfaces", "layers": ["intent"],
     "description": "A point of interaction on a component boundary.",
     "properties": {"direction": {"type": "string", "enum": ["in", "out", "inout"]}, "protocol": {"type": "string"}}},

    {"name": "Action", "family": "Behavior", "layers": ["intent"],
     "description": "Behavior with effects; may implement an Operation.",
     "properties": {"effects": {"type": "array", "items": {"type": "string"}}}},
    {"name": "Event", "family": "Behavior", "layers": ["intent"],
     "description": "A trigger or notification.",
     "properties": {"payload_ref": {"type": "ref"}}},
    {"name": "State", "family": "Behavior", "layers": ["intent"],
     "description": "A modeled lifecycle value of an entity (not a snapshot of the whole graph).",
     "properties": {"entity_ref": {"type": "ref"}, "initial": {"type": "boolean"}, "terminal": {"type": "boolean"}}},
    {"name": "Transition", "family": "Behavior", "layers": ["intent"],
     "description": "A change from one State to another under a trigger and guard.",
     "properties": {
       "from_state": {"type": "ref", "required": true},
       "to_state": {"type": "ref", "required": true},
       "trigger_ref": {"type": "ref"},
       "guard": {"type": "string"}}},
    {"name": "Process", "family": "Behavior", "layers": ["intent"],
     "description": "A sequence or concurrent arrangement of behavior.",
     "properties": {"concurrency_sensitive": {"type": "boolean"}, "steps": {"type": "array", "items": {"type": "string"}}}},

    {"name": "Screen", "family": "Experience", "layers": ["intent"],
     "description": "A user-facing view in the journey.",
     "properties": {"route": {"type": "string"}}},
    {"name": "Control", "family": "Experience", "layers": ["intent"],
     "description": "A user-operable element on a screen.",
     "properties": {"control_kind": {"type": "string"}}},
    {"name": "Interaction", "family": "Experience", "layers": ["intent"],
     "description": "A user gesture or exchange and its feedback.",
     "properties": {}},
    {"name": "PresentationRule", "family": "Experience", "layers": ["intent"],
     "description": "Theme, layout or visual direction; may remain prose.",
     "properties": {}},

    {"name": "Constraint", "family": "Constraints", "layers": ["intent"],
     "description": "An invariant, permission, timing, resource or quality limit. Global constraints are included in every lens.",
     "properties": {
       "constraint_kind": {"type": "string", "enum": ["invariant", "temporal_safety", "temporal_liveness", "permission", "timing", "resource", "quality", "other"], "required": true},
       "scope": {"type": "string", "enum": ["global", "local"]},
       "expression_language": {"type": "string"},
       "expression": {"type": "object"},
       "assumption_refs": {"type": "ref_list"}}},

    {"name": "Decision", "family": "Decisions", "layers": ["intent"],
     "description": "A chosen alternative with rationale. A 'deferral' or 'exclusion' decision concerning a requirement documents that it is deliberately not realized in scope.",
     "properties": {
       "decision_kind": {"type": "string", "enum": ["choice", "deferral", "exclusion"]},
       "alternatives": {"type": "array", "items": {"type": "string"}},
       "rationale": {"type": "string"},
       "decided_by": {"type": "string", "enum": ["user", "agent"]}}},
    {"name": "Assumption", "family": "Decisions", "layers": ["intent"],
     "description": "A dependency on an uncertain fact.",
     "properties": {"status": {"type": "string", "enum": ["unverified", "confirmed", "refuted"], "required": true}, "impact": {"type": "string"}}},

    {"name": "CodeArtifact", "family": "Implementation", "layers": ["observation"],
     "description": "A file, module, package or directory found in a workspace snapshot.",
     "properties": {
       "repository": {"type": "string", "required": true},
       "path": {"type": "string", "required": true},
       "language": {"type": "string"},
       "artifact_kind": {"type": "string", "enum": ["file", "module", "package", "directory", "config", "other"]},
       "content_digest": {"type": "string"},
       "workspace_snapshot_ref": {"type": "string"}}},
    {"name": "CodeSymbol", "family": "Implementation", "layers": ["observation"],
     "description": "A class, function or other named symbol. Line numbers are navigation hints, not identity.",
     "properties": {
       "repository": {"type": "string", "required": true},
       "path": {"type": "string", "required": true},
       "language": {"type": "string"},
       "symbol": {"type": "string", "required": true},
       "locator_kind": {"type": "string", "enum": ["qualified_name", "line_range", "regex", "anchor"]},
       "workspace_snapshot_ref": {"type": "string"},
       "extractor": {"type": "string"},
       "resolution_status": {"type": "string", "enum": ["resolved", "unresolved", "ambiguous"], "required": true}}},
    {"name": "Observation", "family": "Implementation", "layers": ["observation"],
     "description": "An extracted fact about implementation, with its origin and limitations.",
     "properties": {
       "method": {"type": "string", "required": true},
       "observation_kind": {"type": "string"},
       "workspace_snapshot_ref": {"type": "string"},
       "value": {"type": "object"},
       "limitations": {"type": "array", "items": {"type": "string"}}}},

    {"name": "Scope", "family": "Reconciliation", "layers": ["reconciliation"],
     "description": "The set of work and relevant constraints being reviewed or implemented. Explicit members plus a deterministic closure.",
     "properties": {
       "member_refs": {"type": "ref_list", "required": true},
       "status": {"type": "string", "enum": ["draft", "active", "closed"], "required": true},
       "policy_ref": {"type": "string"}}},
    {"name": "WorkspaceSnapshot", "family": "Implementation", "layers": ["observation"],
     "description": "Identity of a repository root at capture time: HEAD, dirty and untracked state, and content digests for the declared paths only.",
     "properties": {
       "repository": {"type": "string", "required": true},
       "root_path": {"type": "string"},
       "head": {"type": "string"},
       "git_available": {"type": "boolean"},
       "dirty": {"type": "boolean"},
       "tracked_dirty": {"type": "array", "items": {"type": "string"}},
       "untracked": {"type": "array", "items": {"type": "string"}},
       "files": {"type": "object"},
       "missing_paths": {"type": "array", "items": {"type": "string"}},
       "lockfiles": {"type": "object"},
       "captured_at": {"type": "string"},
       "tool_version": {"type": "string"}}},
    {"name": "Mapping", "family": "Reconciliation", "layers": ["reconciliation"],
     "description": "A claim connecting model elements to implementation elements, with assessment and gaps.",
     "properties": {
       "model_refs": {"type": "ref_list", "required": true},
       "implementation_refs": {"type": "ref_list", "required": true},
       "mapping_kind": {"type": "string", "enum": ["implements", "tests", "configures", "documents", "partial"], "required": true},
       "assessment_ref": {"type": "ref"},
       "evidence_refs": {"type": "ref_list"},
       "remaining_gaps": {"type": "array", "items": {"type": "string"}}}},
    {"name": "Obligation", "family": "Reconciliation", "layers": ["reconciliation"],
     "description": "Required definition, review or evidence under a policy. A waiver records who authorized it and why.",
     "properties": {
       "obligation_kind": {"type": "string", "required": true},
       "rule": {"type": "string"},
       "gate": {"type": "string", "enum": ["readiness", "conformance", "any"]},
       "blocking": {"type": "boolean", "required": true},
       "state": {"type": "string", "enum": ["pending", "satisfied", "failed", "blocked", "waived"], "required": true},
       "scope_refs": {"type": "ref_list"},
       "required_evidence": {"type": "string"},
       "request": {"type": "string"},
       "acceptable_resolution": {"type": "array", "items": {"type": "string"}},
       "waiver": {"type": "object"}}},
    {"name": "Finding", "family": "Reconciliation", "layers": ["reconciliation"],
     "description": "A check result or discrepancy requiring interpretation or action.",
     "properties": {
       "finding_kind": {"type": "string", "required": true},
       "severity": {"type": "string", "enum": ["info", "warning", "blocker"], "required": true},
       "state": {"type": "string", "enum": ["open", "resolved", "dismissed"], "required": true},
       "related_refs": {"type": "ref_list"},
       "detail": {"type": "string"}}},
    {"name": "Assessment", "family": "Reconciliation", "layers": ["reconciliation"],
     "description": "A recorded judgment by an agent, person or tool, with basis and limitations. A judgment, not computed evidence.",
     "properties": {
       "verdict": {"type": "string", "enum": ["satisfied", "unsatisfied", "uncertain"], "required": true},
       "basis": {"type": "string", "required": true},
       "assessor": {"type": "string", "enum": ["agent", "user", "tool"], "required": true},
       "subject_refs": {"type": "ref_list"},
       "limitations": {"type": "array", "items": {"type": "string"}}}},

    {"name": "TestCase", "family": "Evidence", "layers": ["observation", "reconciliation"],
     "description": "A test definition found in the workspace.",
     "properties": {
       "repository": {"type": "string"}, "path": {"type": "string"},
       "test_id": {"type": "string"}, "runner": {"type": "string"},
       "scenario_refs": {"type": "ref_list"}}},
    {"name": "AnalysisRun", "family": "Evidence", "layers": ["reconciliation"],
     "description": "An execution of an analyzer with its configuration and distinct outcome.",
     "properties": {
       "tool": {"type": "string", "required": true},
       "outcome": {"type": "string", "enum": ["pass", "counterexample", "unknown", "unsupported", "execution_failure"], "required": true},
       "config": {"type": "object"},
       "artifact_ref": {"type": "string"},
       "workspace_snapshot_ref": {"type": "string"},
       "model_scope_digest": {"type": "string"}}},
    {"name": "Evidence", "family": "Evidence", "layers": ["reconciliation"],
     "description": "A scoped result supporting or challenging a claim. Collection mode preserves trust level.",
     "properties": {
       "method": {"type": "string", "required": true},
       "result": {"type": "string", "enum": ["passed", "failed", "inconclusive"], "required": true},
       "collection_mode": {"type": "string", "enum": ["agent_assertion", "agent_submitted_report", "validated_report", "independent_capture"], "required": true},
       "supports": {"type": "ref_list"},
       "workspace_snapshot_ref": {"type": "string"},
       "model_scope_digest": {"type": "string"},
       "tool": {"type": "string"},
       "test_refs": {"type": "ref_list"},
       "artifact_ref": {"type": "string"},
       "artifact_digest": {"type": "string"},
       "report_format": {"type": "string"},
       "declared_inputs": {"type": "object"},
       "model_revision": {"type": "integer"},
       "submitted_by": {"type": "string"},
       "limitations": {"type": "array", "items": {"type": "string"}}}},
    {"name": "Approval", "family": "Evidence", "layers": ["reconciliation"],
     "description": "A source-backed user decision. Agent-recorded approvals are traceability, not proof of identity.",
     "properties": {
       "approval_kind": {"type": "string", "enum": ["build_authorization", "user_acceptance", "waiver"], "required": true},
       "recorded_by": {"type": "string", "enum": ["user", "agent"], "required": true},
       "scope_ref": {"type": "ref"},
       "design_digest": {"type": "string"},
       "policy_ref": {"type": "string"},
       "model_revision": {"type": "integer"},
       "source_statement": {"type": "string"},
       "source_ref": {"type": "string"}}},
    {"name": "ReviewArtifact", "family": "Evidence", "layers": ["reconciliation"],
     "description": "A diagram, mock or summary that depicts model content for human review.",
     "properties": {
       "artifact_kind": {"type": "string", "enum": ["journey", "component_diagram", "sequence_diagram", "ui_mock", "summary", "other"], "required": true},
       "artifact_path": {"type": "string"},
       "scope_digest": {"type": "string"}}}
  ]
}
