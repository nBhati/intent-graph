  "reason": "Record the closure-rule revision, gate semantics for milestone obligations, close the delivered milestone 3 scope, open a standing conformance scope.",
  "operations": [
    {
      "op": "add_annotation",
      "id": "decision:scope-closure-rule",
      "annotation": {
        "role": "rationale",
        "text": "Revised in milestone 4: `realizes` targets join the closure only from specific design elements (operations, actions, processes, screens, controls, interactions, transitions, decisions, scenarios, interfaces), not from shared components or systems. Reconcile showed that a shared component dragged milestone 4 requirements into the milestone 3 scope and invalidated its approval.",
        "refs": [
          "approval:m3-readiness/r8"
        ]
      }
    },
    {
      "op": "update_properties",
      "id": "decision:scope-closure-rule",
      "changes": {
        "rationale": "Deterministic and explainable; every closure member records why it is included. Shared containers do not propagate realized requirements, so one component serving two features does not merge their scopes."
      }
    },
    {
      "op": "update_properties",
      "id": "obligation:m4-evidence-reconciliation",
      "changes": {
        "gate": "conformance"
      }
    },
