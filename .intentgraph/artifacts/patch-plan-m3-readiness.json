    {
      "op": "add_node",
      "record": {
        "id": "operation:readiness",
        "kind": "Operation",
        "label": "Evaluate readiness of a scope",
        "layer": "intent",
        "description": "",
        "properties": {
          "inputs": {
            "scope": "Scope id",
            "policy": "optional policy id"
          },
          "outputs": {
            "status": "ready|needs_work|blocked",
            "design_digest": "sha256",
            "obligations": "list"
          },
          "failures": [
            "unknown_scope",
            "unknown_policy",
            "invalid_policy"
          ],
          "idempotent": true,
          "mode": "sync"
        },
        "lifecycle": "proposed",
