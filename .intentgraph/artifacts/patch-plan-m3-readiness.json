{
  "patch_id": "patch:plan-m3-readiness",
  "base_revision": 5,
  "base_digest": "sha256:bf6790decc990334d9560dda811686892c9c5299b97e76fdf554cbe736c407c5",
  "reason": "Define readiness (inputs, states, errors, policy behaviour, completion criteria) in the self-model before implementing it.",
  "operations": [
    {
      "op": "add_node",
      "record": {
        "id": "req:readiness-evaluates-policy",
        "kind": "Requirement",
        "label": "Readiness evaluates a versioned policy against a scope and returns actionable obligations",
        "layer": "intent",
        "description": "Inputs: a Scope record (explicit members, closure rule, policy ref) and the current snapshot. Output: status, design digest, obligations, warnings, approval state.",
        "properties": {
          "priority": "must",
          "formalization": "descriptive",
          "acceptance_notes": "Each obligation names the rule, the related ids, the request and the acceptable resolutions. Status is ready, needs_work or blocked."
        },
        "lifecycle": "proposed",
        "provenance": {
          "author_role": "agent",
          "method": "planning",
          "source_refs": [
            "doc:vision-and-architecture#13"
          ]
        },
        "annotations": []
      }
    },
    {
      "op": "add_node",
      "record": {
        "id": "req:readiness-does-not-modify",
        "kind": "Requirement",
        "label": "A readiness check never modifies the model or its own policy",
        "layer": "intent",
        "description": "",
        "properties": {
          "priority": "must",
          "formalization": "descriptive",
          "acceptance_notes": "Policy changes are explicit patch operations with a recorded reason."
        },
        "lifecycle": "proposed",
        "provenance": {
          "author_role": "agent",
          "method": "planning",
          "source_refs": [
            "doc:vision-and-architecture#13.1"
          ]
        },
        "annotations": []
      }
    },
    {
      "op": "add_node",
      "record": {
        "id": "req:assertion-cannot-satisfy-executable-evidence",
        "kind": "Requirement",
        "label": "An agent assertion cannot satisfy a rule that requires executable evidence",
        "layer": "intent",
        "description": "",
        "properties": {
          "priority": "must",
          "formalization": "descriptive",
          "acceptance_notes": "Evidence collection modes are ordered: agent_assertion < agent_submitted_report < validated_report < independent_capture."
        },
        "lifecycle": "proposed",
        "provenance": {
          "author_role": "agent",
          "method": "planning",
          "source_refs": [
            "doc:vision-and-architecture#13.2"
          ]
        },
        "annotations": []
      }
    },
    {
      "op": "add_node",
      "record": {
        "id": "req:design-digest-stable-under-approval",
        "kind": "Requirement",
        "label": "Recording an approval or adding evidence does not change the approved design digest",
        "layer": "intent",
        "description": "",
        "properties": {
          "priority": "must",
          "formalization": "descriptive",
          "acceptance_notes": "The design digest covers intent-layer records in the scope closure and the policy version; reconciliation records are excluded."
        },
        "lifecycle": "proposed",
        "provenance": {
          "author_role": "agent",
          "method": "planning",
          "source_refs": [
            "doc:vision-and-architecture#13.3"
          ]
        },
        "annotations": []
      }
    },
    {
      "op": "add_node",
      "record": {
        "id": "req:design-change-invalidates-readiness",
        "kind": "Requirement",
        "label": "A semantic change inside the approved scope invalidates the prior approval and names the affected approval",
        "layer": "intent",
        "description": "",
        "properties": {
          "priority": "must",
          "formalization": "descriptive",
          "acceptance_notes": "Unrelated additions outside the closure leave the approval current."
        },
        "lifecycle": "proposed",
        "provenance": {
          "author_role": "agent",
          "method": "planning",
          "source_refs": [
            "doc:vision-and-architecture#13.3"
          ]
        },
        "annotations": []
      }
    },
    {
      "op": "add_node",
      "record": {
        "id": "req:waiver-requires-user",
        "kind": "Requirement",
        "label": "A waiver is honoured only when it records a user authorization and a reason",
        "layer": "intent",
        "description": "",
        "properties": {
          "priority": "must",
          "formalization": "descriptive",
          "acceptance_notes": "An agent must not invent user approval to clear a blocker."
        },
        "lifecycle": "proposed",
        "provenance": {
          "author_role": "agent",
          "method": "planning",
          "source_refs": [
            "doc:vision-and-architecture#13.1"
          ]
        },
        "annotations": []
      }
    },
    {
      "op": "add_node",
      "record": {
        "id": "req:review-packet-deterministic",
        "kind": "Requirement",
        "label": "The review packet is selected deterministically from the scope and carries its scope digest and coverage",
        "layer": "intent",
        "description": "",
        "properties": {
          "priority": "must",
          "formalization": "descriptive",
          "acceptance_notes": "Prose faithfulness still needs human review; the packet proves which records it covers, not that the explanation is right."
        },
        "lifecycle": "proposed",
        "provenance": {
          "author_role": "agent",
          "method": "planning",
          "source_refs": [
            "doc:vision-and-architecture#14"
          ]
        },
        "annotations": []
      }
    },
    {
      "op": "add_node",
      "record": {
        "id": "question:default-mandatory-rules",
        "kind": "Question",
        "label": "Which readiness rules are mandatory by default?",
        "layer": "intent",
        "description": "",
        "properties": {
          "status": "answered",
          "blocking": false,
          "answer": "v0 default policy: structural checks pass; blocking questions resolved; accepted requirements realized or deliberately deferred; operations define inputs, outputs and failures; concurrency-sensitive processes reviewed; no refuted assumptions; review packet current. Projects override by setting their own policy."
        },
        "lifecycle": "proposed",
        "provenance": {
          "author_role": "agent",
          "method": "planning",
          "source_refs": [
            "doc:vision-and-architecture#24"
          ]
        },
        "annotations": []
      }
    },
    {
      "op": "add_node",
      "record": {
        "id": "decision:policy-rules-declarative",
        "kind": "Decision",
        "label": "Policies are declarative rule records in the snapshot, evaluated by built-in rule types",
        "layer": "intent",
        "description": "",
        "properties": {
          "decided_by": "agent",
          "decision_kind": "choice",
          "rationale": "Keeps policy as versioned data that cannot execute code; new rule types are tool changes, not policy edits.",
          "alternatives": [
            "Python plug-in policies",
            "Policy expressed in intent-expr"
          ]
        },
        "lifecycle": "proposed",
        "provenance": {
          "author_role": "agent",
          "method": "planning",
          "source_refs": [
            "doc:vision-and-architecture#13.1"
          ]
        },
        "annotations": []
      }
    },
    {
      "op": "add_node",
      "record": {
        "id": "decision:scope-closure-rule",
        "kind": "Decision",
        "label": "Scope closure = explicit members, their structural children, realized requirements, applicable constraints, global constraints, and concerning questions, decisions and assumptions",
        "layer": "intent",
        "description": "",
        "properties": {
          "decided_by": "agent",
          "decision_kind": "choice",
          "rationale": "Deterministic and explainable; every closure member records why it is included.",
          "alternatives": [
            "Explicit members only",
            "Full reachability"
          ]
        },
        "lifecycle": "proposed",
        "provenance": {
          "author_role": "agent",
          "method": "planning",
          "source_refs": [
            "doc:vision-and-architecture#24"
          ]
        },
        "annotations": []
      }
    },
