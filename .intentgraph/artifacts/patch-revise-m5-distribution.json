        "id": "req:pypi-package-primary",
        "kind": "Requirement",
        "label": "The Python package published to PyPI is the primary installation route, with one intentgraph command",
        "layer": "intent",
        "description": "",
        "properties": {
          "priority": "must",
          "formalization": "descriptive",
          "acceptance_notes": "uv tool install recommended; pipx alternative; dependencies installed automatically; the tool is not a runtime dependency of the modeled application."
        },
        "lifecycle": "accepted",
        "provenance": {
          "author_role": "user",
          "method": "conversation",
          "source_refs": [
            "chat:session_01M4vsonRLYhnY4LApbNHJo2#user-turn-6",
            "doc:vision-and-architecture#20"
          ]
        },
        "annotations": [
          {
            "role": "original_intent",
            "text": "I'd make a Python package the primary installation route ... uv tool install as the recommended route; pipx as an alternative ... I'd change Milestone 5 to 'publish and validate the installable Python CLI': clean installation, initialization, upgrades, migrations, and uninstall that preserves project files. Standalone executables can come later if users need them.",
            "refs": [
              "chat:session_01M4vsonRLYhnY4LApbNHJo2#user-turn-6",
              "doc:vision-and-architecture#20"
            ]
          }
        ]
      }
