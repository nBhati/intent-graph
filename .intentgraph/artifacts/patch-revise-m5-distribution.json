        "id": "decision:uv-tool-install",
        "kind": "Decision",
        "label": "Distribute as a PyPI package; recommend uv tool install, offer pipx; defer standalone executables",
        "layer": "intent",
        "description": "",
        "properties": {
          "decided_by": "user",
          "decision_kind": "choice",
          "rationale": "uv installs CLI tools in isolated environments and obtains a Python runtime automatically; an executable or npm-first distribution would add another packaging layer to the Python core.",
          "alternatives": [
            "PyInstaller one-file executables per platform (previous decision)",
            "npm-first wrapper"
          ]
        },
        "lifecycle": "accepted",
        "provenance": {
