  "reason": "Plan the milestone 2 improvement (impact slice and graph diff) before implementing it.",
  "operations": [
    {
      "op": "add_node",
      "record": {
        "id": "req:impact-slice",
        "kind": "Requirement",
        "label": "A dependency slice reports which recorded elements a change may affect",
        "layer": "intent",
        "description": "Starting from changed ids, traverse relations in their declared impact direction plus property references, and return candidates with the path that reached them.",
        "properties": {
          "priority": "must",
          "formalization": "descriptive",
          "acceptance_notes": "Reports recorded reachability only and says so; never claims exhaustive impact."
        },
        "lifecycle": "proposed",
        "provenance": {
          "author_role": "agent",
          "method": "planning",
          "source_refs": [
            "doc:vision-and-architecture#10"
          ]
        },
        "annotations": [
          {
            "role": "original_intent",
            "text": "Impact analysis reports recorded reachability and plausible affected elements. It must not claim exhaustive impact when dependencies or mappings are incomplete.",
            "refs": [
              "doc:vision-and-architecture#10"
            ]
          }
        ]
      }
    },
    {
      "op": "add_node",
      "record": {
        "id": "req:graph-diff",
        "kind": "Requirement",
        "label": "Differences between two model revisions are reported at record level",
        "layer": "intent",
        "description": "",
        "properties": {
          "priority": "must",
          "formalization": "descriptive",
          "acceptance_notes": "Transaction summaries give ids since a revision; a second snapshot (file or Git ref) gives field-level changes."
        },
        "lifecycle": "proposed",
        "provenance": {
          "author_role": "agent",
          "method": "planning",
          "source_refs": [
            "doc:vision-and-architecture#21.5"
          ]
        },
        "annotations": [
          {
            "role": "original_intent",
            "text": "Milestone 2 build list: graph diffs, and explicit truncation/boundary reporting.",
            "refs": [
              "doc:vision-and-architecture#21.5"
            ]
          }
        ]
      }
    },
    {
      "op": "add_node",
      "record": {
        "id": "decision:impact-direction-per-relation",
        "kind": "Decision",
        "label": "Each relation declares its impact direction in the vocabulary",
        "layer": "intent",
        "description": "",
        "properties": {
          "decided_by": "agent",
          "rationale": "Keeps impact semantics in the versioned registry (data), not in Python branches; extensions can declare their own.",
          "alternatives": [
            "Hard-code a traversal table in the lens module",
            "Treat every edge as bidirectional impact"
          ]
        },
        "lifecycle": "proposed",
        "provenance": {
          "author_role": "agent",
          "method": "planning",
          "source_refs": [
            "doc:vision-and-architecture#5.5"
          ]
        },
        "annotations": [
          {
            "role": "assumption",
            "text": "Agent-made design decision pending user review; recorded as proposed.",
            "refs": []
          }
        ]
      }
    },
    {
      "op": "add_node",
      "record": {
        "id": "question:impact-refines-upward",
        "kind": "Question",
        "label": "Should a refinement change propagate impact upward to its parent intent?",
        "layer": "intent",
        "description": "",
        "properties": {
          "status": "deferred",
          "blocking": false,
          "answer": "Deferred: v0 propagates parent -> refinement only; upward coverage effects belong to readiness policy (milestone 3)."
        },
        "lifecycle": "proposed",
        "provenance": {
          "author_role": "agent",
          "method": "planning",
